{
  "name": "cypresstestproject",
  "version": "1.0.0",
  "description": "This repository contains end-to-end tests using the Cypress testing framework.",
  "main": "cypress.config.js",
  "dependencies": {
    "ajv": "^8.12.0"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "cypress": "15.21.1",
    "cypress-mochawesome-reporter": "5.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "security:staged": "node scripts/security-gate.mjs",
    "security:hooks": "node scripts/install-security-hook.mjs",
    "security:check": "python3 scripts/security_audit.py"
  },
  "author": "",
  "license": "ISC",
  "overrides": {
    "minimatch": "file:./scripts/security/minimatch-compat.tgz",
    "glob@>=9 <14.0.2": "14.0.3",
    "serialize-javascript": "7.1.4"
  }
}
